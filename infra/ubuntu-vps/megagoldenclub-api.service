[Unit]
Description=MegaGoldenClub compiled API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=megagoldenclub
Group=megagoldenclub
WorkingDirectory=/opt/megagoldenclub/current/api
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3100
EnvironmentFile=/etc/megagoldenclub/api.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0027
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
