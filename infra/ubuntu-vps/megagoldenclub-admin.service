[Unit]
Description=MegaGoldenClub compiled Admin portal
Wants=network-online.target
After=network-online.target megagoldenclub-api.service

[Service]
Type=simple
User=megagoldenclub
Group=megagoldenclub
WorkingDirectory=/opt/megagoldenclub/current/admin
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3101
Environment=MEGAGOLDENCLUB_API_URL=http://127.0.0.1:3100
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictSUIDSGID=true
UMask=0027
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
