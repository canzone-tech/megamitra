NODE_ENV=development
PORT=3100

MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DOCKER_PORT=3307
MYSQL_DATABASE=megamitra
MYSQL_USER=megamitra_app
MYSQL_PASSWORD=CHANGE_ME
DATABASE_URL=mysql://megamitra_app:CHANGE_ME@127.0.0.1:3307/megamitra

MONGODB_DATABASE=megamitra
MONGODB_PORT=27017
MONGODB_URI=mongodb://127.0.0.1:27017/megamitra

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DOCKER_PORT=6380
REDIS_PASSWORD=

CAPTCHA_HMAC_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Public URL used in password-reset / email-verification links.
MEGAMITRA_PUBLIC_URL=http://127.0.0.1:3102

# Optional SMTP relay. Keep email auth features disabled in platform config until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MegaMitra
SMTP_TIMEOUT_MS=10000

# Used only by: npm run super-admin:bootstrap
SUPER_ADMIN_USERNAME=founder
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_ROTATE_PASSWORD=false
