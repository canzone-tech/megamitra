generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum UserIdentifierType {
  EMAIL
  MOBILE
}

enum PasswordCreationMode {
  AUTO
  MANUAL
  AUTO_OR_MANUAL
}

enum UsernameCreationMode {
  AUTO
  MANUAL
  AUTO_OR_MANUAL
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  ROLE_CHANGE
  PERMISSION_CHANGE
  SUSPEND
  ACTIVATE
  BLOCK
  UNBLOCK
}

enum PolicyLifecycle {
  DRAFT
  PUBLISHED
  RETIRED
}

enum BinaryPlacementSide {
  LEFT
  RIGHT
}

enum BinaryVolumeEventType {
  CREDIT
  ADJUSTMENT
  REVERSAL
}

enum BinaryCapOverflowMode {
  CARRY
  FLUSH
}

enum LedgerAccountKind {
  USER_WALLET
  COMMISSION_EXPENSE
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  BINARY_PAIR_COMMISSION
  ADJUSTMENT
  REVERSAL
}

model User {
  id                  String     @id @default(uuid()) @db.Char(36)
  username            String     @unique @db.VarChar(100)
  email               String?    @db.VarChar(191)
  phone               String?    @db.VarChar(30)
  passwordHash        String     @db.VarChar(255)
  firstName           String?    @db.VarChar(100)
  lastName            String?    @db.VarChar(100)
  status              UserStatus @default(PENDING)
  emailVerifiedAt     DateTime?  @db.DateTime(3)
  phoneVerifiedAt     DateTime?  @db.DateTime(3)
  lastLoginAt         DateTime?  @db.DateTime(3)
  mustChangePassword  Boolean    @default(false)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?  @db.DateTime(3)
  createdAt           DateTime   @default(now()) @db.DateTime(3)
  updatedAt           DateTime   @updatedAt @db.DateTime(3)

  roles                     UserRole[]
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  sessions                  AuthSession[]
  identifierClaims          UserIdentifierClaim[]
  securityConfigUpdates     SystemSecurityConfig[]     @relation("SecurityConfigUpdater")
  authConfigUpdates         SystemAuthConfig[]         @relation("AuthConfigUpdater")
  registrationConfigUpdates SystemRegistrationConfig[] @relation("RegistrationConfigUpdater")
  sponsorRelationship       SponsorRelationship?       @relation("SponsorMember")
  sponsoredMembers          SponsorRelationship[]      @relation("SponsorOwner")
  binaryPlacement           BinaryPlacement?           @relation("PlacementMember")
  binaryChildren            BinaryPlacement[]          @relation("PlacementParent")
  binaryAncestorLinks       BinaryAncestry[]           @relation("BinaryAncestor")
  binaryDescendantLinks     BinaryAncestry[]           @relation("BinaryDescendant")
  binaryVolumeEvents        BinaryVolumeEvent[]        @relation("VolumeSourceMember")
  binaryVolumeCredits       BinaryUplineVolumeCredit[] @relation("VolumeCreditAncestor")
  binarySettlements         BinaryPairSettlement[]     @relation("SettlementMember")
  ledgerAccounts            LedgerAccount[]            @relation("LedgerAccountOwner")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id                   String                     @id @default(uuid()) @db.Char(36)
  name                 String                     @unique @db.VarChar(100)
  description          String?                    @db.VarChar(255)
  status               RoleStatus                 @default(ACTIVE)
  createdAt            DateTime                   @default(now()) @db.DateTime(3)
  updatedAt            DateTime                   @updatedAt @db.DateTime(3)
  users                UserRole[]
  permissions          RolePermission[]
  registrationDefaults SystemRegistrationConfig[] @relation("RegistrationDefaultRole")

  @@index([status])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @db.Char(36)
  roleId     String   @db.Char(36)
  assignedAt DateTime @default(now()) @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @db.Char(36)
  permissionId String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Char(36)
  actorUserId String?     @db.Char(36)
  action      AuditAction
  entityType  String      @db.VarChar(100)
  entityId    String?     @db.VarChar(100)
  description String?     @db.VarChar(500)
  metadata    Json?
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.VarChar(1000)
  createdAt   DateTime    @default(now()) @db.DateTime(3)
  actorUser   User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AuthSession {
  id                 String    @id @db.Char(36)
  userId             String    @db.Char(36)
  refreshTokenHash   String    @unique @db.Char(64)
  expiresAt          DateTime  @db.DateTime(3)
  lastSeenAt         DateTime  @db.DateTime(3)
  absoluteExpiresAt  DateTime  @db.DateTime(3)
  revokedAt          DateTime? @db.DateTime(3)
  revocationReason   String?   @db.VarChar(100)
  rotatedToSessionId String?   @db.Char(36)
  createdAt          DateTime  @default(now()) @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @db.DateTime(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([absoluteExpiresAt])
  @@index([userId, lastSeenAt])
  @@map("auth_sessions")
}

model SystemSecurityConfig {
  id                            Int      @id @default(1)
  idleTimeoutMinutes            Int      @default(30)
  absoluteSessionTimeoutMinutes Int      @default(1440)
  maxActiveSessions             Int      @default(5)
  maxFailedLoginAttempts        Int      @default(5)
  lockoutMinutes                Int      @default(15)
  passwordMinLength             Int      @default(12)
  passwordMaxLength             Int      @default(128)
  refreshTokenRotationEnabled   Boolean  @default(true)
  updatedByUserId               String?  @db.Char(36)
  createdAt                     DateTime @default(now()) @db.DateTime(3)
  updatedAt                     DateTime @updatedAt @db.DateTime(3)
  updatedByUser                 User?    @relation("SecurityConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("system_security_config")
}

model SystemAuthConfig {
  id                           Int      @id @default(1)
  loginWithUsername            Boolean  @default(true)
  loginWithEmail               Boolean  @default(true)
  loginWithMobile              Boolean  @default(true)
  captchaOnLoginEnabled        Boolean  @default(false)
  captchaOnRegistrationEnabled Boolean  @default(false)
  captchaTtlSeconds             Int      @default(300)
  accessTokenTtlSeconds         Int      @default(900)
  refreshTokenTtlSeconds        Int      @default(2592000)
  updatedByUserId               String?  @db.Char(36)
  createdAt                     DateTime @default(now()) @db.DateTime(3)
  updatedAt                     DateTime @updatedAt @db.DateTime(3)
  updatedByUser                 User?    @relation("AuthConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("system_auth_config")
}

model SystemRegistrationConfig {
  id                                Int                  @id @default(1)
  publicRegistrationEnabled         Boolean              @default(true)
  emailRequired                     Boolean              @default(true)
  mobileRequired                    Boolean              @default(false)
  passwordMode                      PasswordCreationMode @default(MANUAL)
  usernameMode                      UsernameCreationMode @default(AUTO_OR_MANUAL)
  usernamePrefixEnabled             Boolean              @default(false)
  usernamePrefix                    String?              @db.VarChar(20)
  defaultRoleName                   String               @default("MEMBER") @db.VarChar(100)
  allowMultipleAccountsPerEmail     Boolean              @default(false)
  allowMultipleAccountsPerMobile    Boolean              @default(false)
  updatedByUserId                   String?              @db.Char(36)
  createdAt                         DateTime             @default(now()) @db.DateTime(3)
  updatedAt                         DateTime             @updatedAt @db.DateTime(3)
  updatedByUser                     User?                @relation("RegistrationConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  defaultRole                       Role                 @relation("RegistrationDefaultRole", fields: [defaultRoleName], references: [name], onDelete: Restrict, onUpdate: Cascade)

  @@index([updatedByUserId])
  @@index([defaultRoleName])
  @@map("system_registration_config")
}

model UserIdentifierClaim {
  id              String             @id @default(uuid()) @db.Char(36)
  userId          String             @db.Char(36)
  type            UserIdentifierType
  normalizedValue String             @db.VarChar(191)
  createdAt       DateTime           @default(now()) @db.DateTime(3)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, normalizedValue])
  @@index([userId, type])
  @@map("user_identifier_claims")
}

model SystemSequence {
  key       String   @id @db.VarChar(100)
  nextValue BigInt
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@map("system_sequences")
}

model SponsorRelationship {
  id              String   @id @default(uuid()) @db.Char(36)
  memberUserId    String   @unique @db.Char(36)
  sponsorUserId   String   @db.Char(36)
  createdByUserId String?  @db.Char(36)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  member          User     @relation("SponsorMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  sponsor         User     @relation("SponsorOwner", fields: [sponsorUserId], references: [id], onDelete: Restrict)

  @@index([sponsorUserId])
  @@map("sponsor_relationships")
}

model BinaryPlacement {
  id              String              @id @default(uuid()) @db.Char(36)
  memberUserId    String              @unique @db.Char(36)
  parentUserId    String              @db.Char(36)
  side            BinaryPlacementSide
  createdByUserId String?             @db.Char(36)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  member          User                @relation("PlacementMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  parent          User                @relation("PlacementParent", fields: [parentUserId], references: [id], onDelete: Restrict)

  @@unique([parentUserId, side])
  @@index([parentUserId])
  @@map("binary_placements")
}

model BinaryAncestry {
  ancestorUserId   String              @db.Char(36)
  descendantUserId String              @db.Char(36)
  depth            Int
  firstLegSide     BinaryPlacementSide
  createdAt        DateTime            @default(now()) @db.DateTime(3)
  ancestor         User                @relation("BinaryAncestor", fields: [ancestorUserId], references: [id], onDelete: Restrict)
  descendant       User                @relation("BinaryDescendant", fields: [descendantUserId], references: [id], onDelete: Restrict)

  @@id([ancestorUserId, descendantUserId])
  @@index([ancestorUserId, depth])
  @@index([descendantUserId, depth])
  @@map("binary_ancestry")
}

model BinaryPlan {
  id              String              @id @default(uuid()) @db.Char(36)
  code            String              @unique @db.VarChar(50)
  name            String              @db.VarChar(120)
  description     String?             @db.VarChar(500)
  createdByUserId String?             @db.Char(36)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)
  versions        BinaryPlanVersion[]

  @@map("binary_plans")
}

model BinaryPlanVersion {
  id                     String                     @id @default(uuid()) @db.Char(36)
  planId                 String                     @db.Char(36)
  version                Int
  lifecycle              PolicyLifecycle            @default(DRAFT)
  effectiveFrom          DateTime                   @db.DateTime(3)
  effectiveTo            DateTime?                  @db.DateTime(3)
  qualifyingUnit         Decimal                    @db.Decimal(18, 4)
  leftVolumePerPair      Decimal                    @db.Decimal(18, 4)
  rightVolumePerPair     Decimal                    @db.Decimal(18, 4)
  pairPayoutAmount       Decimal                    @db.Decimal(18, 2)
  currencyCode           String?                    @db.VarChar(3)
  settlementTimezone     String?                    @db.VarChar(100)
  capOverflowMode        BinaryCapOverflowMode?
  dailyPairCap           Int?
  monthlyPairCap         Int?
  carryForwardEnabled    Boolean
  carryForwardExpiryDays Int?
  qualificationRules     Json?
  settlementRules        Json?
  createdByUserId        String?                    @db.Char(36)
  publishedByUserId      String?                    @db.Char(36)
  retiredByUserId        String?                    @db.Char(36)
  publishedAt            DateTime?                  @db.DateTime(3)
  retiredAt              DateTime?                  @db.DateTime(3)
  createdAt              DateTime                   @default(now()) @db.DateTime(3)
  updatedAt              DateTime                   @updatedAt @db.DateTime(3)
  plan                   BinaryPlan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  volumeEvents           BinaryVolumeEvent[]
  uplineCredits          BinaryUplineVolumeCredit[]
  settlements            BinaryPairSettlement[]

  @@unique([planId, version])
  @@index([planId, lifecycle])
  @@index([lifecycle, effectiveFrom, effectiveTo])
  @@map("binary_plan_versions")
}

model BinaryVolumeEvent {
  id                 String                @id @default(uuid()) @db.Char(36)
  sourceKey          String                @unique @db.VarChar(191)
  sourceMemberUserId String                @db.Char(36)
  planVersionId      String                @db.Char(36)
  eventType          BinaryVolumeEventType
  volume             Decimal               @db.Decimal(18, 4)
  reversalOfEventId  String?               @unique @db.Char(36)
  occurredAt         DateTime              @db.DateTime(3)
  metadata           Json?
  createdByUserId    String?               @db.Char(36)
  createdAt          DateTime              @default(now()) @db.DateTime(3)
  sourceMember       User                  @relation("VolumeSourceMember", fields: [sourceMemberUserId], references: [id], onDelete: Restrict)
  planVersion        BinaryPlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  reversalOf         BinaryVolumeEvent?    @relation("VolumeReversal", fields: [reversalOfEventId], references: [id], onDelete: Restrict)
  reversedBy         BinaryVolumeEvent?    @relation("VolumeReversal")
  uplineCredits      BinaryUplineVolumeCredit[]

  @@index([sourceMemberUserId, occurredAt])
  @@index([planVersionId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("binary_volume_events")
}

model BinaryUplineVolumeCredit {
  id             String              @id @default(uuid()) @db.Char(36)
  volumeEventId  String              @db.Char(36)
  ancestorUserId String              @db.Char(36)
  planVersionId  String              @db.Char(36)
  side           BinaryPlacementSide
  depth          Int
  volume         Decimal             @db.Decimal(18, 4)
  createdAt      DateTime            @default(now()) @db.DateTime(3)
  volumeEvent    BinaryVolumeEvent   @relation(fields: [volumeEventId], references: [id], onDelete: Restrict)
  ancestor       User                @relation("VolumeCreditAncestor", fields: [ancestorUserId], references: [id], onDelete: Restrict)
  planVersion    BinaryPlanVersion   @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@unique([volumeEventId, ancestorUserId])
  @@index([ancestorUserId, side, createdAt])
  @@index([planVersionId, createdAt])
  @@map("binary_upline_volume_credits")
}

model BinaryPairSettlement {
  id                      String            @id @default(uuid()) @db.Char(36)
  sourceKey               String            @unique @db.VarChar(191)
  memberUserId            String            @db.Char(36)
  planVersionId           String            @db.Char(36)
  settledAt               DateTime          @db.DateTime(3)
  settlementLocalDate     String            @db.Char(10)
  settlementLocalMonth    String            @db.Char(7)
  leftAvailableBefore     Decimal           @db.Decimal(18, 4)
  rightAvailableBefore    Decimal           @db.Decimal(18, 4)
  pairCountCalculated     Int
  pairCountPayable        Int
  capLimitedPairs         Int
  leftVolumeConsumed      Decimal           @db.Decimal(18, 4)
  rightVolumeConsumed     Decimal           @db.Decimal(18, 4)
  leftCarryAfter          Decimal           @db.Decimal(18, 4)
  rightCarryAfter         Decimal           @db.Decimal(18, 4)
  payoutAmount            Decimal           @db.Decimal(18, 2)
  currencyCode            String            @db.VarChar(3)
  ledgerTransactionId     String?           @unique @db.Char(36)
  createdByUserId         String?           @db.Char(36)
  createdAt               DateTime          @default(now()) @db.DateTime(3)
  member                  User              @relation("SettlementMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  planVersion             BinaryPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  ledgerTransaction       LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([memberUserId, planVersionId, settledAt])
  @@index([memberUserId, planVersionId, settlementLocalDate])
  @@index([memberUserId, planVersionId, settlementLocalMonth])
  @@map("binary_pair_settlements")
}

model LedgerAccount {
  id           String            @id @default(uuid()) @db.Char(36)
  code         String            @unique @db.VarChar(120)
  name         String            @db.VarChar(150)
  kind         LedgerAccountKind
  ownerUserId  String?           @db.Char(36)
  currencyCode String            @db.VarChar(3)
  createdAt    DateTime          @default(now()) @db.DateTime(3)
  ownerUser    User?             @relation("LedgerAccountOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  entries      LedgerEntry[]

  @@index([ownerUserId, kind, currencyCode])
  @@index([kind, currencyCode])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id               String                @id @default(uuid()) @db.Char(36)
  sourceKey        String                @unique @db.VarChar(191)
  type             LedgerTransactionType
  description      String?               @db.VarChar(500)
  occurredAt       DateTime              @db.DateTime(3)
  createdByUserId  String?               @db.Char(36)
  createdAt        DateTime              @default(now()) @db.DateTime(3)
  entries          LedgerEntry[]
  binarySettlement BinaryPairSettlement?

  @@index([type, occurredAt])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String               @id @default(uuid()) @db.Char(36)
  transactionId String               @db.Char(36)
  accountId     String               @db.Char(36)
  direction     LedgerEntryDirection
  amount        Decimal              @db.Decimal(18, 2)
  currencyCode  String               @db.VarChar(3)
  createdAt     DateTime             @default(now()) @db.DateTime(3)
  transaction   LedgerTransaction    @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}
